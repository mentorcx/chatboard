        [
          {
            "node": "Normalize Reconcile Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Tasks (Placeholder Endpoint)": {
      "main": [
        [
          {
            "node": "Normalize Reconcile Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Reconcile Data": {
