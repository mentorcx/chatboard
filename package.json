{
  "name": "chatboard-kpi-dashboard",
  "version": "1.0.0",
  "description": "MVP Dashboard de KPIs Conversacionales (Kommo + Supabase + Metabase)",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "lint": "tsc --noEmit",
    "migrate": "echo 'Ejecutá los SQL en sql/ sobre Supabase'"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/node-cron": "^3.0.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
